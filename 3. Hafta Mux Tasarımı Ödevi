module mux4to1_8bit (
    input  logic [7:0] d0,  // 1. 8-bit giriş
    input  logic [7:0] d1,  // 2. 8-bit giriş
    input  logic [7:0] d2,  // 3. 8-bit giriş
    input  logic [7:0] d3,  // 4. 8-bit giriş
    input  logic [1:0] sel, // 2-bit seçici sinyal (00, 01, 10, 11)
    output logic [7:0] y    // 8-bit çıkış
);

    always_comb begin
        case (sel)
            2'b00: y = d0;
            2'b01: y = d1;
            2'b10: y = d2;
            2'b11: y = d3;
            default: y = 8'b0; 
        endcase
    end

endmodule

module tb_mux4to1_8bit;

   
    logic [7:0] d0, d1, d2, d3;
    logic [1:0] sel;
    logic [7:0] y;

    
    mux4to1_8bit dut (
        .d0(d0),
        .d1(d1),
        .d2(d2),
        .d3(d3),
        .sel(sel),
        .y(y)
    );

    
    initial begin
        
        d0 = 8'hAA; // 10101010
        d1 = 8'hBB; // 10111011
        d2 = 8'hCC; // 11001100
        d3 = 8'hDD; // 11011101

        
        $display("Zaman\t sel\t Çıkış (y)");
        $display("---------------------------");

        
        sel = 2'b00; #10; $display("%0t\t %b\t %h", $time, sel, y); 
        sel = 2'b01; #10; $display("%0t\t %b\t %h", $time, sel, y); 
        sel = 2'b10; #10; $display("%0t\t %b\t %h", $time, sel, y); 
        sel = 2'b11; #10; $display("%0t\t %b\t %h", $time, sel, y); 

        
        $finish;
    end

endmodule
