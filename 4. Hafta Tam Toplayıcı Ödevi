module full_adder (
    input logic a,
    input logic b,
    input logic cin,
    output logic sum,
    output logic cout
);
    assign sum = a ^ b ^ cin;
    assign cout = (a & b) | (cin & (a ^ b));
endmodule

module full_adder_4bit (
    input  logic [3:0] a,
    input  logic [3:0] b,
    input  logic cin,
    output logic [3:0] sum,
    output logic cout
);
    logic c1, c2, c3; 

    // Ripple Carry: Elde sinyalleri sırayla bir sonraki bitin girişine aktarılır
    full_adder fa0 (.a(a[0]), .b(b[0]), .cin(cin), .sum(sum[0]), .cout(c1));
    full_adder fa1 (.a(a[1]), .b(b[1]), .cin(c1),  .sum(sum[1]), .cout(c2));
    full_adder fa2 (.a(a[2]), .b(b[2]), .cin(c2),  .sum(sum[2]), .cout(c3));
    full_adder fa3 (.a(a[3]), .b(b[3]), .cin(c3),  .sum(sum[3]), .cout(cout));

endmodule



module tb_full_adder_4bit;

    logic [3:0] a, b;
    logic cin;
    logic [3:0] sum;
    logic cout;

    full_adder_4bit dut (
        .a(a),
        .b(b),
        .cin(cin),
        .sum(sum),
        .cout(cout)
    );

    initial begin
        $display("Zaman\t a\t b\t cin\t |\t cout\t sum");
        $display("----------------------------------------------------");

        // Test 1: 3 + 4 = 7
        a = 4'b0011; b = 4'b0100; cin = 0; #10;
        $display("%0t\t %d\t %d\t %b\t |\t %b\t %d", $time, a, b, cin, cout, sum);

        // Test 2: 7 + 8 = 15
        a = 4'b0111; b = 4'b1000; cin = 0; #10;
        $display("%0t\t %d\t %d\t %b\t |\t %b\t %d", $time, a, b, cin, cout, sum);

        // Test 3: 15 + 1 = 16 (4-bit taşması: cout = 1, sum = 0)
        a = 4'b1111; b = 4'b0001; cin = 0; #10;
        $display("%0t\t %d\t %d\t %b\t |\t %b\t %d", $time, a, b, cin, cout, sum);

        // Test 4: Elde girişi ile toplama (10 + 5 + 1 = 16)
        a = 4'b1010; b = 4'b0101; cin = 1; #10;
        $display("%0t\t %d\t %d\t %b\t |\t %b\t %d", $time, a, b, cin, cout, sum);

        $finish;
    end

endmodule
